    "topic-management.persistence.ackQuorum": 2,
    "topic-management.partitions": 100,
    "topic-management.partitionsToBrokersRatio": 2.0,
    "topic-management.topicFactory.props": {
    },
    "produce.producer.props": {
      "enableBatch": false,
      "batchingMaxPublishDelayMs": 2,
      "batchingMaxBytes": 102400,
      "blockIfQueueFull": false,
      "maxPendingMessages": 100000,
      "sendTimeoutMs": 30000
    },
    "consume.latency.sla.ms": 20000,
    "consume.consumer.props": {
      "receiverQueueSize": 10000
    }
