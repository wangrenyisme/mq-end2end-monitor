{
  "pulsar-serverless-sh": {
    "class.name": "com.linkedin.xinfra.monitor.apps.SinglePulsarClusterMonitor",
    "topic": "persistent://public/default/test2",
    "service.url": "pulsar://localhost:6650",
    "http.url": "http://localhost:8080",
    "produce.record.delay.ms": 100,
    "produce.record.rate.sec": 100000,
    "produce.sync": false,
