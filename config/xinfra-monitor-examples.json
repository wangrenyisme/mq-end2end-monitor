{
  "MetadataSyncTask": {
    "class.name": "com.linkedin.xinfra.monitor.apps.ClusterGroupMetadataSyncTask",

    "cluster-groups": {
      "cluster-group01": {
        "_comment": "Example: main-cluster has ACL (SASL_PLAINTEXT), backup-cluster is plain. ACL sync is skipped because not ALL clusters have ACL enabled.",
        "main-cluster": {
          "bootstrap.servers": "localhost:9092",
          "security.protocol": "SASL_PLAINTEXT",
          "sasl.mechanism": "SCRAM-SHA-256",
          "sasl.jaas.config": "org.apache.kafka.common.security.scram.ScramLoginModule required username='your_username' password='your_password';"
        },
        "backup-cluster": {
          "bootstrap.servers": "localhost:9093"
        }
      },
      "cluster-group02": {
        "_comment": "Example: both clusters have ACL enabled — topic metadata AND ACLs will be synced bidirectionally.",
        "primary-cluster": {
          "bootstrap.servers": "primary-host:9092",
          "security.protocol": "SASL_PLAINTEXT",
          "sasl.mechanism": "SCRAM-SHA-256",
          "sasl.jaas.config": "org.apache.kafka.common.security.scram.ScramLoginModule required username='admin' password='admin-secret';"
        },
        "standby-cluster": {
          "bootstrap.servers": "standby-host:9092",
          "security.protocol": "SASL_PLAINTEXT",
          "sasl.mechanism": "SCRAM-SHA-256",
          "sasl.jaas.config": "org.apache.kafka.common.security.scram.ScramLoginModule required username='admin' password='admin-secret';"
        }
      }
    },

    "sync.interval.seconds": 60,

    "excluded.topics": "__consumer_offsets,__transaction_state",

    "max.replication.factor": 3,

    "request.timeout.ms": 30000
  },
  "kafka-cluster-a": {
    "class.name": "com.linkedin.xinfra.monitor.apps.SingleClusterMonitor",
    "topic": "xinfra-monitor-topic",
    "zookeeper.connect": "localhost:2181",
    "bootstrap.servers": "localhost:9092",
    "request.timeout.ms": 9000,
    "produce.record.delay.ms": 100,
    "topic-management.topicManagementEnabled": true,
    "topic-management.topicCreationEnabled": true,
    "topic-management.replicationFactor": 1,
    "topic-management.partitionsToBrokersRatio": 2,
    "topic-management.rebalance.interval.ms": 600000,
    "topic-management.preferred.leader.election.check.interval.ms": 300000,
    "topic-management.topicFactory.props": {},
    "topic-management.topic.props": {
      "retention.ms": "3600000"
    },
    "produce.producer.props": {
      "client.id": "kmf-client-id"
    },
    "consume.latency.sla.ms": "20000",
    "consume.consumer.props": {}
  },
  "pulsar_cluster_a": {
    "class.name": "com.linkedin.xinfra.monitor.apps.SinglePulsarClusterMonitor",
    "topic": "persistent://apache/pulsar/test-topic",
    "token": "your_token",
    "url": "pulsar://pulsar.com:6650",
    "http.url": "http://pulsar.com:8080",
    "subscription.name": "your_subscription_name"
  },
  "kafka-cluster-open-acl": {
    "class.name": "com.linkedin.xinfra.monitor.apps.SingleClusterMonitor",
    "topic": "xinfra-monitor-topic",
    "zookeeper.connect": "localhost:2181",
    "bootstrap.servers": "localhost:9092",
    "request.timeout.ms": 9000,
    "produce.record.delay.ms": 100,
    "topic-management.topicManagementEnabled": false,
    "topic-management.topicCreationEnabled": true,
    "topic-management.replicationFactor": 2,
    "topic-management.partitionsToBrokersRatio": 2,
    "topic-management.rebalance.interval.ms": 600000,
    "topic-management.preferred.leader.election.check.interval.ms": 300000,
    "security.protocol": "SASL_PLAINTEXT",
    "sasl.mechanism": "SCRAM-SHA-256",
    "sasl.jaas.config": "org.apache.kafka.common.security.scram.ScramLoginModule required username='your_username' password='your_password';",
    "topic-management.topicFactory.props": {},
    "topic-management.topic.props": {
      "retention.ms": "3600000"
    },
    "produce.producer.props": {
      "client.id": "kmf-client-id",
      "security.protocol": "SASL_PLAINTEXT",
      "sasl.mechanism": "SCRAM-SHA-256",
      "sasl.jaas.config": "org.apache.kafka.common.security.scram.ScramLoginModule required username='your_username' password='your_password';"
    },
    "consume.latency.sla.ms": "20000",
    "consume.consumer.props": {
      "security.protocol": "SASL_PLAINTEXT",
      "sasl.mechanism": "SCRAM-SHA-256",
      "sasl.jaas.config": "org.apache.kafka.common.security.scram.ScramLoginModule required username='your_username' password='your_password';"
    }
  }
}